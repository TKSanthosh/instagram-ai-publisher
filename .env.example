# ==============================================================================
# Instagram AI Publisher - Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# NEVER commit your actual .env file or real secrets to git.
# ==============================================================================

# Mode
# Set to 'true' to generate & store image without publishing to Instagram
DRY_RUN=false

# Google Gemini API Configuration (Nano Banana models)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
# Configurable Nano Banana model (e.g. gemini-2.5-flash-image, gemini-3.1-flash-image)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Meta Instagram Graph API Configuration
# Meta for Developers: https://developers.facebook.com/
# Requires an Instagram Professional (Business or Creator) account linked to a Facebook Page
# Token requires permissions: instagram_content_publish, pages_read_engagement, instagram_basic
INSTAGRAM_ACCESS_TOKEN=
# Numeric Instagram Business / Creator Account ID (obtainable via Graph API)
INSTAGRAM_USER_ID=
META_GRAPH_API_VERSION=v22.0

# Supabase Storage Configuration
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Service role key (secret, bypasses RLS for server-side uploads; NEVER expose in client/frontend)
SUPABASE_SERVICE_ROLE_KEY=
# Dedicated public storage bucket name for Instagram images
SUPABASE_STORAGE_BUCKET=instagram-images
# Set to true only if your bucket is private and you wish to test signed URLs (Defaults to false for direct public bucket URL)
SUPABASE_USE_SIGNED_URL=false
SUPABASE_SIGNED_URL_EXPIRES_IN=1800

# Post Configuration
# Caption text for the Instagram post
POST_CAPTION=Exploring the future of Artificial Intelligence and technology 🚀✨ #AI #Innovation #TechFuture
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1350
IMAGE_ASPECT_RATIO=4:5

# Resilience & Retries
MAX_RETRIES=3
RETRY_DELAY_MS=1000
REQUEST_TIMEOUT_MS=60000

# State / Idempotency Window in minutes (prevents duplicate posting within window)
IDEMPOTENCY_WINDOW_MINUTES=60
